<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameLauncher"
        Title="Game Launcher"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#111827">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Vertical"
                        DockPanel.Dock="Left">
                <TextBlock Text="Game Launcher"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Välj ett spel att spela."
                           Foreground="#9CA3AF"
                           FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right">
                <ComboBox x:Name="DiscordChannelCombo"
                          Width="180"
                          Margin="0,0,8,0"
                          DisplayMemberPath="Label"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center"/>
                <Button Content="Anslut till röstchatt"
                        Click="Discord_Click"
                        Margin="0,0,8,0"
                        Padding="16,4"
                        Background="#000000"
                        Foreground="White"
                        BorderBrush="#374151"
                        BorderThickness="1"
                        Cursor="Hand" />
                <Button Content="Admin"
                        Click="Admin_Click"
                        Padding="16,4"
                        Margin="16,0,0,0"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        BorderThickness="1"
                        Cursor="Hand" />
            </StackPanel>
        </DockPanel>

        <!-- Games grid -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GamesGrid"
                          MouseLeftButtonUp="GamesGrid_MouseLeftButtonUp">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True"
                                   Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:GameDefinition}">
                        <Border Width="220"
                                Height="360"
                                Margin="8"
                                Background="#020617"
                                CornerRadius="16"
                                Cursor="Hand">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="60" />
                                </Grid.RowDefinitions>

                                <Border CornerRadius="16,16,0,0"
                                        Grid.Row="0"
                                        ClipToBounds="True"
                                        Background="#111827">
                                    <Image Source="{Binding FullImagePath}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Row="1"
                                            Margin="12">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PlatformDisplay}"
                                               Foreground="#9CA3AF"
                                               FontSize="11"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>

